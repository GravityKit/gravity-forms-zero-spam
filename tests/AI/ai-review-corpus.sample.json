  "cases": [
    {
      "id": "review-obvious-seo-spam",
      "label": "spam",
      "scenario": "review",
      "form_title": "Contact Us",
      "source_path": "/contact/",
      "fields": [
        {
          "label": "Name",
          "type": "name",
          "value": "Best SEO Agency"
        },
        {
          "label": "Email",
          "type": "email",
          "value": "rankings@example-spam.test"
        },
        {
          "label": "Message",
          "type": "textarea",
          "value": "Hello webmaster, buy 10,000 backlinks and guaranteed casino traffic from our SEO package today."
        }
      ],
      "expected_review_is_spam": true,
      "expected_rescue": false,
      "notes": "Obvious unsolicited promotional spam."
    },

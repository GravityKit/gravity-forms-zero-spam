includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - .
    phpVersion: 70400
    excludePaths:
        - vendor/
        - node_modules/
        - dist/
        - svn/
        - gravity-forms-zero-spam/
    bootstrapFiles:
        - %currentWorkingDirectory%/vendor/php-stubs/gravity-forms-stubs/gravity-forms-stubs.php
    ignoreErrors:
        - '#(Used )?[Cc]onstant GF_ZERO_SPAM_\w+ not found#'
        - '#Parameter \#6 \$sub_type of static method GFAPI::add_note\(\) expects null, string given#'
        - '#Function gf_apply_filters invoked with \d+ parameters, 2 required#'
        - '#Action callback returns (bool|int) but should not return anything#'
        - '#Cannot access property \$title on object\|true#'
        # WP 7.0 AI Client — no phpstan stubs available yet.
        -
            message: '#Function wp_ai_client_prompt not found#'
            path: includes/class-gf-zero-spam-ai-review.php
        -
            message: '#Call to static method fromArray\(\) on an unknown class WordPress\\AiClient\\Providers\\Http\\DTO\\RequestOptions\.#'
            path: includes/class-gf-zero-spam-ai-review.php
        -
            message: '#Access to constant KEY_TIMEOUT on an unknown class WordPress\\AiClient\\Providers\\Http\\DTO\\RequestOptions\.#'
            path: includes/class-gf-zero-spam-ai-review.php
    treatPhpDocTypesAsCertain: false

# WordPress environment.
WP_ENV_URL=http://localhost
# Ports are auto-assigned if not set (finds first available from 8800).
# WP_ENV_PORT=8888
# WP_ENV_TESTS_PORT=8889
WP_ENV_USER=admin
WP_ENV_USER_PASS=password
WP_ENV_PHP_VERSION=8.2

# Comma-separated local plugin paths to mount in wp-env.
# Point this at an unzipped Gravity Forms plugin directory.
# Run `npm run tests:e2e:download-gf` to fetch the latest GF release into .tmp/gravityforms.
WP_ENV_PLUGINS=

# License keys.
GRAVITY_FORMS_LICENSE_KEY=

# Playwright WebSocket port (auto-assigned if not set, from 53333).
# PW_WS_PORT=53333

# Set to 1 to use a locally installed Chromium instead of Docker.
# Supports SLOW_MO=<ms> for debugging when enabled.
USE_LOCAL_BROWSER=
SLOW_MO=

# Set to 1 to keep E2E test data between runs (skip cleanup).
E2E_KEEP_DATA=

# Override the test directory at runtime (optional).
TEST_DIR=

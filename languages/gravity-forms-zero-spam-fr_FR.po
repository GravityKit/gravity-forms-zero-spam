msgstr "L’expiration maximale est de 90 jours."

#: includes/class-gf-zero-spam-addon.php:1030
msgid "The maximum expiration is 2160 hours (90 days)."
msgstr "L’expiration maximale est de 2160 heures (90 jours)."


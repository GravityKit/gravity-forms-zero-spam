msgstr "אנא הזן לפחות שעה אחת."

#: includes/class-gf-zero-spam-addon.php:1291
msgid "Please select hours or days."
msgstr "אנא בחר שעות או ימים."

#: includes/class-gf-zero-spam-addon.php:1296

msgstr "Um form_id válido é obrigatório."

#: includes/class-gf-zero-spam-token-endpoint.php:74
msgid "Form not found."
msgstr "Formulário não encontrado."

#: includes/class-gf-zero-spam-token-endpoint.php:81
